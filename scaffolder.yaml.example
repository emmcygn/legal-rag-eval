dataset_path: src/scaffolder/data/synthetic_contracts_v1.json
output_path: results/evidence-benchmark.json
strategies:
  - lexichunk
  - token_window
  - rcts
retrieval_depth: 5
context_budget_tokens: 128
token_window_tokens: 64
token_window_overlap: 8
rcts_chunk_chars: 512
rcts_chunk_overlap: 50
lexichunk_max_tokens: 512
