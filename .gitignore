# Python
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
dist/
build/
*.egg

# Virtual environments. `.venv-*` covers the per-LexiChunk-build environments the
# baseline-vs-fixed comparison needs (uv writes a self-ignoring .gitignore into a venv it
# creates, but `python -m venv` does not, so name the pattern rather than relying on that).
.venv/
.venv-*/
venv/
env/

# IDE
.vscode/
.idea/
*.swp
*.swo

# Type checking
.mypy_cache/

# Testing
.pytest_cache/
htmlcov/
.coverage
coverage.xml

# Ruff
.ruff_cache/

# Project-specific
# Benchmark outputs. The published runs are committed: the README's results tables are
# generated from them, so a reader has to be able to see the run behind a published
# number. Those live in a subdirectory named after the LexiChunk build that produced them
# (results/lexichunk_fixed/, results/lexichunk_baseline/), plus results/external/ for the
# LEDGAR and CUAD evaluations. Ad-hoc runs land in results/ itself with the CLI's default
# filenames and are not committed, so `make benchmark-structural` on a developer's machine
# never rewrites the evidence. Rendered reports and caches are not committed either.
# The contents are excluded rather than the directory itself, because git does not descend
# into an excluded directory and the negations below would never be reached.
results/*
!results/README.md
!results/*/
results/*/*
!results/*/*.json
!results/external/*.md
.cache/
*.faiss
requirements.lock
legal-rag-eval.yaml

# Internal build artifacts (agent plans, research, task tracking)
plans/
reference-docs/
research-docs/
tasks/lessons.md
tasks/gap-analysis-*.md

# Claude Code settings
.claude/
CLAUDE.md

# Environment variables
.env
.env.local

# OS
.DS_Store
Thumbs.db
